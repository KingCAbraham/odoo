<!-- Views for chatbot documents -->
<odoo>
  <record id="view_ai_doc_tree" model="ir.ui.view">
    <field name="name">odoo_ai_chatbot.document.tree</field>
    <field name="model">odoo_ai_chatbot.document</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="filename"/>
        <field name="active"/>
    </list>

    </field>
  </record>

  <record id="view_ai_doc_form" model="ir.ui.view">
    <field name="name">odoo_ai_chatbot.document.form</field>
    <field name="model">odoo_ai_chatbot.document</field>
    <field name="arch" type="xml">
      <form string="Documento RAG">
        <sheet>
          <group>
            <field name="name"/>
            <field name="file" filename="filename"/>
            <field name="filename"/>
            <field name="active"/>
          </group>

          <footer>
            <button name="action_index" type="object" class="btn-primary" string="Indexar (crear embeddings)"/>
          </footer>

          <notebook>
            <page string="Chunks">
              <field name="chunk_ids">
                <list>
                  <field name="sequence"/>
                  <field name="content"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_ai_documents" model="ir.actions.act_window">
    <field name="name">Documentos (RAG)</field>
    <field name="res_model">odoo_ai_chatbot.document</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_ai_chat_client" model="ir.actions.client">
    <field name="name">AI Chat</field>
    <field name="tag">odoo_ai_chatbot.chat_client</field>
  </record>
</odoo>
