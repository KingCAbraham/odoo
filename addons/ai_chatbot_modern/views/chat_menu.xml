<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- Client Action (JS) -->
    <record id="action_ai_chatbot_modern_chat" model="ir.actions.client">
      <field name="name">AI Chatbot</field>
      <field name="tag">ai_chatbot_modern.chat</field>
    </record>

    <!-- Menú raíz -->
    <menuitem id="menu_ai_chatbot_modern_root" name="AI Chatbot" sequence="10"/>

    <!-- Chat -->
    <menuitem id="menu_ai_chatbot_modern_chat"
              name="Chat"
              parent="menu_ai_chatbot_modern_root"
              action="action_ai_chatbot_modern_chat"
              sequence="10"/>

    <!-- Documentos (esta acción debe existir en documents_views.xml con este mismo id) -->
    <menuitem id="menu_ai_chatbot_modern_documents"
              name="Documentos"
              parent="menu_ai_chatbot_modern_root"
              action="action_ai_chatbot_modern_document"
              sequence="20"/>

    <!-- Ajustes (usamos ajustes generales de Odoo) -->
    <menuitem id="menu_ai_chatbot_modern_settings"
              name="Ajustes"
              parent="menu_ai_chatbot_modern_root"
              action="base_setup.action_general_configuration"
              sequence="30"/>

  </data>
</odoo>
