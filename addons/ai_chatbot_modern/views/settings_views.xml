<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="res_config_settings_view_form_ai_chatbot_modern" model="ir.ui.view">
    <field name="name">res.config.settings.ai.chatbot.modern</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
    <field name="arch" type="xml">

      <xpath expr="//form" position="inside">
        <app string="AI Chatbot Modern" name="ai_chatbot_modern">
          <block title="AI Chatbot Modern (RAG)">

            <setting id="ai_chatbot_modern_provider" string="Proveedor">
              <field name="ai_chatbot_modern_provider"/>
            </setting>

            <setting id="ai_chatbot_modern_openai_api_key"
                     string="OpenAI API Key"
                     help="Guárdala aquí para usar OpenAI como proveedor.">
              <field name="ai_chatbot_modern_openai_api_key" password="True"
                     invisible="ai_chatbot_modern_provider != 'openai'"/>
            </setting>

            <setting id="ai_chatbot_modern_openai_chat_model" string="Modelo de chat (OpenAI)">
              <field name="ai_chatbot_modern_openai_chat_model"
                     invisible="ai_chatbot_modern_provider != 'openai'"/>
            </setting>

            <setting id="ai_chatbot_modern_openai_embed_model" string="Modelo de embeddings (OpenAI)">
              <field name="ai_chatbot_modern_openai_embed_model"
                     invisible="ai_chatbot_modern_provider != 'openai'"/>
            </setting>

            <separator string="Groq"/>

            <setting id="ai_chatbot_modern_groq_api_key"
                     string="Groq API Key"
                     help="Guárdala aquí para usar Groq como proveedor.">
              <field name="ai_chatbot_modern_groq_api_key" password="True"
                     invisible="ai_chatbot_modern_provider != 'groq'"/>
            </setting>

            <setting id="ai_chatbot_modern_groq_chat_model" string="Modelo de chat (Groq)">
              <field name="ai_chatbot_modern_groq_chat_model"
                     invisible="ai_chatbot_modern_provider != 'groq'"/>
            </setting>

            <setting id="ai_chatbot_modern_groq_embed_model" string="Modelo de embeddings (Groq)">
              <field name="ai_chatbot_modern_groq_embed_model"
                     invisible="ai_chatbot_modern_provider != 'groq'"/>
            </setting>

            <separator string="RAG"/>

            <setting id="ai_chatbot_modern_rag_top_k" string="Top K (RAG)">
              <field name="ai_chatbot_modern_rag_top_k"/>
            </setting>

          </block>
        </app>
      </xpath>

    </field>
  </record>

</odoo>
