<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Acción: XML ID = ai_chatbot_modern.action_ai_chatbot_modern_document -->
        <record id="action_ai_chatbot_modern_document" model="ir.actions.act_window">
            <field name="name">Documentos RAG</field>
            <field name="res_model">ai_chatbot_modern.document</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Desde aquí puedes cargar archivos TXT o PDF y procesarlos para que el chatbot los use como contexto.
                </p>
            </field>
        </record>

        <record id="view_ai_chatbot_modern_document_list" model="ir.ui.view">
            <field name="name">ai_chatbot_modern.document.list</field>
            <field name="model">ai_chatbot_modern.document</field>
            <field name="arch" type="xml">
                <list string="Documentos RAG">
                    <field name="name"/>
                    <field name="filename" string="Nombre de archivo"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_ai_chatbot_modern_document_form" model="ir.ui.view">
            <field name="name">ai_chatbot_modern.document.form</field>
            <field name="model">ai_chatbot_modern.document</field>
            <field name="arch" type="xml">
                <form string="Documento RAG">
                    <header>
                        <button name="action_index" type="object" string="Indexar" class="oe_highlight"/>
                    </header>

                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>

                        <notebook>
                            <page string="Chunks" groups="base.group_system">
                                <field name="chunk_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" readonly="1"/>
                                        <field name="content"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
